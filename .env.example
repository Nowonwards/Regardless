# Database (Local Docker Setup: run `yarn db:up` or `docker compose up -d`)
DATABASE_URL="postgresql://regardless:regardless_dev@localhost:5432/regardless?schema=public"
DIRECT_URL="postgresql://regardless:regardless_dev@localhost:5432/regardless?schema=public"

# Note for Production / Vercel:
# Set DATABASE_URL to your Supabase Transaction Pooler URL (with ?pgbouncer=true)
# Set DIRECT_URL to your Supabase Direct Session Pooler URL (port 5432)

# Ollama
OLLAMA_BASE_URL="https://api.ollama.com"
OLLAMA_API_KEY=""
